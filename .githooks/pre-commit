#!/usr/bin/env bash
set -euo pipefail

# Git pre-commit hook: Compile Cursor and Copilot rule files from AGENTS.md
echo "Running Rhizo rule compiler (scripts/compile_rules.py)..."
python3 scripts/compile_rules.py

# Stage any freshly updated rule files if git is staging
if git rev-parse --verify HEAD >/dev/null 2>&1; then
    git add skills/rhizo/rules/cursor-rules.mdc skills/rhizo/rules/copilot-instructions.md
    if [ -f ".github/copilot-instructions.md" ]; then
        git add .github/copilot-instructions.md
    fi
    if [ -f ".cursor/rules/rhizo.mdc" ]; then
        git add .cursor/rules/rhizo.mdc
    fi
fi
